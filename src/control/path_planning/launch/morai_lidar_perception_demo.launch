<launch>
  <!-- Internal launch shared by the three standalone perception demos. -->
  <arg name="algorithm_type" />
  <arg name="algorithm_name" />
  <arg name="result_prefix" />
  <arg name="rviz_config" />
  <arg name="rviz" default="true" />

  <arg name="bind_ip" default="0.0.0.0" />
  <arg name="host_port" default="2000" />
  <arg name="destination_port" default="2001" />
  <arg name="deskew_enabled" default="true" />
  <arg name="deskew_pose_source" default="sensor_udp" />
  <arg name="gps_port" default="3001" />
  <arg name="imu_port" default="4001" />
  <arg name="pose_bind_ip" default="127.0.0.1" />
  <arg name="pose_port" default="4012" />
  <arg name="vertical_support_enabled" default="true" />
  <arg name="vertical_support_filter_cloud" default="true" />

  <arg name="input_topic" default="/morai/lidar/live_points" />
  <arg name="raw_display_topic" default="/morai/lidar/display_points" />
  <arg name="cluster_cloud_topic"
       default="/morai/lidar/$(arg result_prefix)/clustered_points" />
  <arg name="marker_topic"
       default="/morai/lidar/$(arg result_prefix)/markers" />
  <arg name="result_topic"
       default="/morai/lidar/$(arg result_prefix)/results" />

  <arg name="cluster_tolerance_m" default="0.8" />
  <arg name="cluster_min_points" default="3" />
  <arg name="cluster_max_points" default="0" />
  <arg name="cluster_min_height_m" default="0.10" />
  <arg name="cluster_max_clusters" default="32" />
  <arg name="cluster_max_input_points" default="5000" />
  <arg name="x_min_m" default="-40.0" />
  <arg name="x_max_m" default="40.0" />
  <arg name="y_abs_m" default="8.0" />
  <arg name="z_min_m" default="-1.4" />
  <arg name="z_max_m" default="2.5" />
  <arg name="marker_lifetime_s" default="0.15" />

  <arg name="match_distance_m" default="3.0" />
  <arg name="min_hits" default="3" />
  <arg name="max_missed" default="6" />
  <arg name="process_accel_std_mps2" default="4.0" />
  <arg name="measurement_noise_m" default="0.35" />
  <arg name="velocity_scale_s" default="1.0" />

  <!-- MORAI sensor input remains direct UDP.  Its built-in clustering and
       merge-gap outputs are disabled so only the selected demo is visible. -->
  <include file="$(find path_planning)/launch/morai_lidar_rviz.launch">
    <arg name="rviz" value="false" />
    <arg name="bind_ip" value="$(arg bind_ip)" />
    <arg name="host_port" value="$(arg host_port)" />
    <arg name="destination_port" value="$(arg destination_port)" />
    <arg name="deskew_enabled" value="$(arg deskew_enabled)" />
    <arg name="deskew_pose_source" value="$(arg deskew_pose_source)" />
    <arg name="gps_port" value="$(arg gps_port)" />
    <arg name="imu_port" value="$(arg imu_port)" />
    <arg name="pose_bind_ip" value="$(arg pose_bind_ip)" />
    <arg name="pose_port" value="$(arg pose_port)" />
    <arg name="topic" value="$(arg input_topic)" />
    <arg name="display_topic" value="$(arg raw_display_topic)" />
    <arg name="vertical_support_enabled" value="$(arg vertical_support_enabled)" />
    <arg name="vertical_support_filter_cloud" value="$(arg vertical_support_filter_cloud)" />
    <arg name="fast_nearest_enabled" value="false" />
    <arg name="cluster_enabled" value="false" />
    <arg name="merge_gap_enabled" value="false" />
  </include>

  <node pkg="path_planning"
        type="$(arg algorithm_type)"
        name="$(arg algorithm_name)"
        output="screen">
    <param name="input_topic" value="$(arg input_topic)" />
    <param name="cluster_cloud_topic" value="$(arg cluster_cloud_topic)" />
    <param name="marker_topic" value="$(arg marker_topic)" />
    <param name="result_topic" value="$(arg result_topic)" />
    <param name="cluster_tolerance_m" value="$(arg cluster_tolerance_m)" />
    <param name="cluster_min_points" value="$(arg cluster_min_points)" />
    <param name="cluster_max_points" value="$(arg cluster_max_points)" />
    <param name="cluster_min_height_m" value="$(arg cluster_min_height_m)" />
    <param name="cluster_max_clusters" value="$(arg cluster_max_clusters)" />
    <param name="cluster_max_input_points" value="$(arg cluster_max_input_points)" />
    <param name="x_min_m" value="$(arg x_min_m)" />
    <param name="x_max_m" value="$(arg x_max_m)" />
    <param name="y_abs_m" value="$(arg y_abs_m)" />
    <param name="z_min_m" value="$(arg z_min_m)" />
    <param name="z_max_m" value="$(arg z_max_m)" />
    <param name="marker_lifetime_s" value="$(arg marker_lifetime_s)" />
    <param name="match_distance_m" value="$(arg match_distance_m)" />
    <param name="min_hits" value="$(arg min_hits)" />
    <param name="max_missed" value="$(arg max_missed)" />
    <param name="process_accel_std_mps2" value="$(arg process_accel_std_mps2)" />
    <param name="measurement_noise_m" value="$(arg measurement_noise_m)" />
    <param name="velocity_scale_s" value="$(arg velocity_scale_s)" />
  </node>

  <node if="$(arg rviz)"
        pkg="rviz"
        type="rviz"
        name="$(arg algorithm_name)_rviz"
        args="-d $(find path_planning)/rviz/$(arg rviz_config)"
        output="screen" />
</launch>
