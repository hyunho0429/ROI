<launch>
  <!-- Stage F: first controlled integration.
       The existing perception/localization stack stays intact, but its original
       Pure Pursuit instance is control-disabled.  A separate ROS wrapper uses
       the SAME MgeoPurePursuit.compute geometry on /avoidance_path_manager/active_path. -->

  <arg name="morai_host_ip" default="192.168.0.161" />
  <arg name="path_file"
       default="$(find morai_bringup)/../../../data/routes/2026_molit_comp_global_path.txt" />
  <arg name="link_set_file"
       default="$(find morai_bringup)/../../../data/mgeo/link_set.json" />

  <!-- Keep FALSE for preflight. Set true only after active_path/state/stop topics are verified. -->
  <arg name="enable_control" default="false" />
  <arg name="target_speed_mps" default="3.0" />

  <!-- Existing team stack: sensors, localization, LiDAR, camera, RViz, drive bridge.
       Its built-in Pure Pursuit is intentionally prevented from publishing /ctrl_cmd. -->
  <include file="$(find morai_bringup)/launch/morai_udp_ekf_purepursuit_lidar_camera.launch">
    <arg name="morai_host_ip" value="$(arg morai_host_ip)" />
    <arg name="enable_control" value="false" />
  </include>

  <!-- Our planner: candidate generation + OBB safety + selected_path. -->
  <include file="$(find purepursuit_mgeo)/launch/frenet_avoidance_debug.launch">
    <arg name="path_file" value="$(arg path_file)" />
    <arg name="link_set_file" value="$(arg link_set_file)" />
    <arg name="evaluation_speed_mps" value="$(arg target_speed_mps)" />
  </include>

  <!-- Commitment / fail-safe path manager.  First controlled stage executes BYPASS only. -->
  <node pkg="purepursuit_mgeo"
        type="avoidance_path_manager_node.py"
        name="avoidance_path_manager"
        output="screen">
    <param name="path_file" value="$(arg path_file)" />
    <param name="map_frame" value="map" />
    <param name="odom_topic" value="/localization/odometry" />
    <param name="obstacle_topic" value="/perception/lidar/tracked_obstacles_map" />

    <param name="selected_path_topic" value="/avoidance_frenet_debug/selected_path" />
    <param name="planner_ready_topic" value="/avoidance_frenet_debug/planner_ready" />
    <param name="avoidance_required_topic" value="/avoidance_frenet_debug/avoidance_required" />
    <param name="safe_path_available_topic" value="/avoidance_frenet_debug/safe_path_available" />
    <param name="selected_kind_topic" value="/avoidance_frenet_debug/selected_kind" />
    <param name="selected_side_topic" value="/avoidance_frenet_debug/selected_side" />

    <param name="allow_lane_change_control" value="false" />
    <param name="rate_hz" value="10.0" />
    <param name="normal_back_m" value="3.0" />
    <param name="normal_forward_m" value="80.0" />

    <param name="vehicle_length_m" value="4.635" />
    <param name="vehicle_width_m" value="1.892" />
    <param name="vehicle_center_from_base_m" value="1.50" />
    <param name="collision_longitudinal_margin_m" value="0.25" />
    <param name="collision_lateral_margin_m" value="0.20" />
  </node>

  <!-- Same verified Pure Pursuit geometry, now fed by active_path.
       It is the ONLY node allowed to publish actual control in this launch. -->
  <node pkg="purepursuit_mgeo"
        type="purepursuit_mgeo_active_node.py"
        name="purepursuit_mgeo_active"
        output="screen">
    <param name="path_file" value="$(arg path_file)" />
    <param name="pose_topic" value="/localization/odometry" />
    <param name="command_topic" value="/ctrl_cmd" />
    <param name="map_frame" value="map" />

    <param name="enable_control" value="$(arg enable_control)" />
    <param name="target_speed_mps" value="$(arg target_speed_mps)" />
    <param name="longl_cmd_type" value="2" />
    <param name="wheelbase_m" value="3.0" />
    <param name="lookahead_min_m" value="4.0" />
    <param name="lookahead_gain" value="0.35" />
    <param name="goal_tolerance_m" value="1.5" />
    <param name="max_steering_rad" value="0.6981317008" />
    <param name="control_rate_hz" value="20.0" />

    <param name="use_active_path" value="true" />
    <param name="require_active_path" value="true" />
    <param name="active_path_topic" value="/avoidance_path_manager/active_path" />
    <param name="active_path_timeout_s" value="0.60" />

    <param name="external_stop_topic" value="/avoidance_path_manager/stop_required" />
    <param name="require_external_stop_status" value="true" />
    <param name="external_stop_timeout_s" value="0.60" />

    <param name="pedestrian_stop_topic" value="/perception/pedestrian_crossing/stop_required" />
    <param name="require_pedestrian_status" value="true" />
    <param name="pedestrian_stop_timeout_s" value="0.75" />

    <param name="odom_timeout_s" value="0.50" />
    <param name="lookahead_topic" value="/control/active_lookahead_point" />
    <param name="steering_preview_topic" value="/control/active_steering_preview" />
  </node>
</launch>
