<launch>
  <!-- Stage D/E visual safety evaluation. Never publishes /ctrl_cmd. -->
  <arg name="path_file"
       default="$(find morai_bringup)/../../../data/routes/2026_molit_comp_global_path.txt" />
  <arg name="link_set_file"
       default="$(find morai_bringup)/../../../data/mgeo/link_set.json" />

  <arg name="odom_topic" default="/localization/odometry" />
  <arg name="obstacle_topic" default="/perception/lidar/tracked_obstacles_map" />
  <arg name="map_frame" default="map" />

  <!-- Duplicate RViz-only outputs in the existing perception frame.
       Planner calculations remain in map. -->
  <arg name="publish_lidar_visualization" default="true" />
  <arg name="lidar_viz_frame" default="morai_lidar" />
  <arg name="lidar_viz_prefix" default="/avoidance_frenet_debug_lidar" />
  <!-- Keep these equal to lidar_tracking.launch extrinsics. Current integrated defaults are 0/0/0. -->
  <arg name="lidar_x_m" default="0.0" />
  <arg name="lidar_y_m" default="0.0" />
  <arg name="lidar_z_m" default="0.0" />
  <arg name="lidar_yaw_deg" default="0.0" />
  <arg name="lidar_global_back_m" default="10.0" />
  <arg name="lidar_global_forward_m" default="55.0" />
  <arg name="lidar_global_spacing_m" default="0.75" />

  <!-- RViz Fixed Frame=morai_lidar requires morai_lidar to exist in the TF tree.
       Current integrated LiDAR extrinsics are 0/0/0, so publish an identity
       base_link -> morai_lidar transform for this debug stage. -->
  <arg name="publish_lidar_tf" default="true" />

  <arg name="rate_hz" default="10.0" />
  <arg name="local_length_m" default="45.0" />
  <arg name="sample_spacing_m" default="0.5" />

  <!-- Confirmed vehicle dimensions. -->
  <arg name="vehicle_length_m" default="4.635" />
  <arg name="vehicle_width_m" default="1.892" />
  <arg name="vehicle_height_m" default="2.434" />
  <!-- Provisional: Pure Pursuit treats base_link as rear axle center. Verify in RViz. -->
  <arg name="vehicle_center_from_base_m" default="1.50" />
  <arg name="candidate_corridor_margin_m" default="0.20" />

  <!-- A LiDAR track triggers avoidance candidates only when it overlaps the
       global-path vehicle corridor and is close enough ahead. -->
  <arg name="trigger_distance_m" default="30.0" />
  <arg name="trigger_lateral_margin_m" default="0.25" />

  <!-- Adjacent-lane sampling. -->
  <arg name="lane_change_start_distances_m" default="[3.0, 7.0, 11.0]" />
  <arg name="lane_change_lengths_m" default="[15.0, 22.0]" />
  <arg name="always_show_lane_candidates" default="false" />

  <!-- One-lane/free-space bypass sampling. This does NOT yet check road polygons. -->
  <arg name="bypass_lateral_margin_m" default="0.30" />
  <arg name="bypass_longitudinal_margin_m" default="2.0" />
  <arg name="bypass_departure_length_m" default="10.0" />
  <arg name="bypass_return_length_m" default="10.0" />
  <arg name="bypass_extra_clearances_m" default="[0.0, 0.35]" />
  <arg name="bypass_max_abs_d_m" default="3.0" />
  <arg name="bypass_min_transition_length_m" default="4.0" />
  <arg name="allow_bypass_with_adjacent_lane" default="false" />

  <!-- Candidate safety evaluation. Stage F path manager consumes the selected safe path. -->
  <arg name="odom_timeout_s" default="0.50" />
  <arg name="obstacle_timeout_s" default="0.60" />
  <arg name="collision_longitudinal_margin_m" default="0.25" />
  <arg name="collision_lateral_margin_m" default="0.20" />
  <arg name="wheelbase_m" default="3.0" />
  <arg name="max_steering_rad" default="0.6981317008" />
  <!-- First real-driving tests should be slower than the current 6 m/s cruise. -->
  <arg name="evaluation_speed_mps" default="3.0" />
  <arg name="max_lateral_accel_mps2" default="2.5" />
  <arg name="collision_sample_stride" default="1" />

  <node if="$(arg publish_lidar_tf)"
        pkg="tf"
        type="static_transform_publisher"
        name="avoidance_debug_base_link_to_morai_lidar"
        args="0 0 0 0 0 0 base_link morai_lidar 100" />

  <node pkg="purepursuit_mgeo"
        type="avoidance_frenet_debug_node.py"
        name="avoidance_frenet_debug"
        output="screen">
    <param name="path_file" value="$(arg path_file)" />
    <param name="link_set_file" value="$(arg link_set_file)" />
    <param name="odom_topic" value="$(arg odom_topic)" />
    <param name="obstacle_topic" value="$(arg obstacle_topic)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="publish_lidar_visualization" value="$(arg publish_lidar_visualization)" />
    <param name="lidar_viz_frame" value="$(arg lidar_viz_frame)" />
    <param name="lidar_viz_prefix" value="$(arg lidar_viz_prefix)" />
    <param name="lidar_x_m" value="$(arg lidar_x_m)" />
    <param name="lidar_y_m" value="$(arg lidar_y_m)" />
    <param name="lidar_z_m" value="$(arg lidar_z_m)" />
    <param name="lidar_yaw_deg" value="$(arg lidar_yaw_deg)" />
    <param name="lidar_global_back_m" value="$(arg lidar_global_back_m)" />
    <param name="lidar_global_forward_m" value="$(arg lidar_global_forward_m)" />
    <param name="lidar_global_spacing_m" value="$(arg lidar_global_spacing_m)" />
    <param name="rate_hz" value="$(arg rate_hz)" />
    <param name="local_length_m" value="$(arg local_length_m)" />
    <param name="sample_spacing_m" value="$(arg sample_spacing_m)" />

    <param name="vehicle_length_m" value="$(arg vehicle_length_m)" />
    <param name="vehicle_width_m" value="$(arg vehicle_width_m)" />
    <param name="vehicle_height_m" value="$(arg vehicle_height_m)" />
    <param name="vehicle_center_from_base_m" value="$(arg vehicle_center_from_base_m)" />
    <param name="candidate_corridor_margin_m" value="$(arg candidate_corridor_margin_m)" />

    <param name="trigger_distance_m" value="$(arg trigger_distance_m)" />
    <param name="trigger_lateral_margin_m" value="$(arg trigger_lateral_margin_m)" />

    <param name="lane_change_start_distances_m" value="$(arg lane_change_start_distances_m)" />
    <param name="lane_change_lengths_m" value="$(arg lane_change_lengths_m)" />
    <param name="always_show_lane_candidates" value="$(arg always_show_lane_candidates)" />

    <param name="bypass_lateral_margin_m" value="$(arg bypass_lateral_margin_m)" />
    <param name="bypass_longitudinal_margin_m" value="$(arg bypass_longitudinal_margin_m)" />
    <param name="bypass_departure_length_m" value="$(arg bypass_departure_length_m)" />
    <param name="bypass_return_length_m" value="$(arg bypass_return_length_m)" />
    <param name="bypass_extra_clearances_m" value="$(arg bypass_extra_clearances_m)" />
    <param name="bypass_max_abs_d_m" value="$(arg bypass_max_abs_d_m)" />
    <param name="bypass_min_transition_length_m" value="$(arg bypass_min_transition_length_m)" />
    <param name="allow_bypass_with_adjacent_lane" value="$(arg allow_bypass_with_adjacent_lane)" />

    <param name="odom_timeout_s" value="$(arg odom_timeout_s)" />
    <param name="obstacle_timeout_s" value="$(arg obstacle_timeout_s)" />
    <param name="collision_longitudinal_margin_m" value="$(arg collision_longitudinal_margin_m)" />
    <param name="collision_lateral_margin_m" value="$(arg collision_lateral_margin_m)" />
    <param name="wheelbase_m" value="$(arg wheelbase_m)" />
    <param name="max_steering_rad" value="$(arg max_steering_rad)" />
    <param name="evaluation_speed_mps" value="$(arg evaluation_speed_mps)" />
    <param name="max_lateral_accel_mps2" value="$(arg max_lateral_accel_mps2)" />
    <param name="collision_sample_stride" value="$(arg collision_sample_stride)" />
  </node>
</launch>
