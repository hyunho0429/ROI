<launch>
  <!-- Final driving stack:
       sensor-team canonical stack (UNCHANGED camera files)
       + F6 lane-agnostic obstacle BYPASS
       + proactive highway LEFT lane strategy with persistent inner-lane hold
       + speed adaptation using tracked front/rear vehicles
       + roundabout merge gate
       + sensor-team Pure Pursuit geometry / longlCmdType=1.
  -->

  <arg name="morai_host_ip" default="192.168.0.161" />
  <arg name="path_file"
       default="$(find morai_bringup)/../../../data/routes/2026_molit_comp_global_path.txt" />
  <arg name="link_set_file"
       default="$(find morai_bringup)/../../../data/mgeo/R_KR_PR_K-city_2025/link_set.json" />
  <arg name="enable_control" default="false" />
  <!-- First validation: 2 m/s. Raise to 6 m/s only after CONTROL-OFF + low-speed checks. -->
  <arg name="target_speed_mps" default="2.0" />
  <arg name="managed_timeout_s" default="1.0" />

  <!-- Camera-team source files remain UNCHANGED.  Our wrapper only launches
       their existing live_lane_info_publisher_v2.py so lane_info is available. -->
  <arg name="enable_lane_info_publisher" default="true" />
  <arg name="lane_info_topic" default="/perception/camera/lane_info" />
  <arg name="lane_info_ip" default="0.0.0.0" />
  <arg name="lane_info_port" default="1101" />
  <arg name="lane_info_checkpoint" default="$(find camera_perception)/lane/lane_seg_best.pt" />
  <arg name="lane_info_cam_set" default="$(find camera_perception)/lane/cam_set.json" />
  <arg name="lane_info_device" default="auto" />
  <arg name="lane_info_every" default="1" />
  <arg name="highway_environment_topic" default="/perception/camera/highway_environment" />
  <arg name="highway_request_topic" default="/planning/highway_lane_change_request" />
  <arg name="target_left_lane_changes" default="1" />

  <!-- Obstacle BYPASS policy:
       BYPASS never depends on camera lane validity, solid/dashed markings, or
       intersection detection.  F6 geometric/safety limits remain active. -->

  <!-- Debug-only base_link -> morai_lidar TF. Disable if the sensor stack already publishes it. -->
  <arg name="publish_lidar_tf" default="true" />
  <arg name="lidar_x_m" default="0.0" />
  <arg name="lidar_y_m" default="0.0" />
  <arg name="lidar_z_m" default="0.0" />
  <arg name="lidar_yaw_deg" default="0.0" />

  <!-- Roundabout mission gate. -->
  <arg name="merge_request_topic" default="/planning/merge_request" />
  <arg name="enable_roundabout_merge_gate" default="true" />
  <arg name="roundabout_override_intersection_stop" default="true" />

  <!-- Final Pure Pursuit input is the highway strategy output. Outside highway
       mode the highway node transparently republishes the normal PathManager path. -->
  <param name="/purepursuit_mgeo/use_active_path" value="true" />
  <param name="/purepursuit_mgeo/active_path_topic"
         value="/highway_lane_strategy/active_path" />
  <param name="/purepursuit_mgeo/require_path_manager_status" value="true" />
  <param name="/purepursuit_mgeo/stop_required_topic"
         value="/highway_lane_strategy/stop_required" />
  <param name="/purepursuit_mgeo/managed_timeout_s" value="$(arg managed_timeout_s)" />
  <param name="/purepursuit_mgeo/use_target_speed_override" value="true" />
  <param name="/purepursuit_mgeo/target_speed_override_topic"
         value="/highway_lane_strategy/target_speed_mps" />
  <param name="/purepursuit_mgeo/target_speed_override_timeout_s" value="1.0" />

  <param name="/purepursuit_mgeo/enable_merge_gate" value="$(arg enable_roundabout_merge_gate)" />
  <param name="/purepursuit_mgeo/merge_stop_topic" value="/roundabout_merge_gate/stop_required" />
  <param name="/purepursuit_mgeo/merge_allowed_topic" value="/roundabout_merge_gate/allowed" />
  <param name="/purepursuit_mgeo/merge_request_topic" value="$(arg merge_request_topic)" />
  <param name="/purepursuit_mgeo/roundabout_override_intersection_stop"
         value="$(arg roundabout_override_intersection_stop)" />

  <!-- Sensor-team canonical stack. Camera overlay / lane-info source stay untouched. -->
  <include file="$(find morai_bringup)/launch/morai_udp_ekf_purepursuit_lidar_camera.launch">
    <arg name="path_file" value="$(arg path_file)" />
    <arg name="morai_host_ip" value="$(arg morai_host_ip)" />
    <arg name="target_speed_mps" value="$(arg target_speed_mps)" />
    <arg name="enable_control" value="$(arg enable_control)" />
    <!-- One UDP consumer only: live_lane_info_publisher_v2.py owns MORAI lane port 1101. -->
    <arg name="enable_lane" value="false" />
  </include>

  <!-- Launch the camera team's EXISTING lane-info publisher without modifying it.
       The canonical camera launch above does not publish /perception/camera/lane_info. -->
  <node if="$(arg enable_lane_info_publisher)"
        pkg="purepursuit_mgeo"
        type="lane_info_runner.py"
        name="lane_info_runner"
        output="screen"
        args="--ip $(arg lane_info_ip) --port $(arg lane_info_port) --checkpoint $(arg lane_info_checkpoint) --cam-set $(arg lane_info_cam_set) --device $(arg lane_info_device) --every $(arg lane_info_every) --topic $(arg lane_info_topic)" />

  <!-- Republish the camera team's semantic lane topics from lane_info JSON.
       This replaces the second live_overlay inference process without changing camera-team source files. -->
  <node pkg="purepursuit_mgeo"
        type="lane_info_semantic_adapter.py"
        name="lane_info_semantic_adapter"
        output="screen">
    <param name="lane_info_topic" value="$(arg lane_info_topic)" />
    <param name="dashed_lane_topic" value="/perception/camera/dashed_lane_detected" />
    <param name="left_solid_lane_topic" value="/perception/camera/left_solid_lane_detected" />
    <param name="left_yellow_solid_lane_topic" value="/perception/camera/left_yellow_solid_lane_detected" />
    <param name="right_solid_lane_topic" value="/perception/camera/right_solid_lane_detected" />
    <param name="stopline_detected_topic" value="/perception/camera/stopline_detected" />
    <param name="stopline_distance_topic" value="/perception/camera/stopline_distance_m" />
    <param name="stale_timeout_s" value="0.75" />
  </node>

  <!-- Base F6.3 obstacle planner: no MGeo lane-change candidates. -->
  <include file="$(find purepursuit_mgeo)/launch/frenet_avoidance_debug.launch">
    <arg name="path_file" value="$(arg path_file)" />
    <arg name="link_set_file" value="$(arg link_set_file)" />
    <arg name="evaluation_speed_mps" value="$(arg target_speed_mps)" />
    <arg name="local_length_m" value="55.0" />
    <arg name="trigger_distance_m" value="35.0" />
    <arg name="trigger_lateral_margin_m" value="0.05" />
    <arg name="trigger_lateral_half_cap_m" value="1.25" />
    <arg name="candidate_corridor_margin_m" value="0.45" />
    <arg name="enable_mgeo_lane_candidates" value="false" />
    <arg name="allow_bypass_with_adjacent_lane" value="true" />
    <arg name="publish_lidar_tf" value="$(arg publish_lidar_tf)" />
    <arg name="lidar_x_m" value="$(arg lidar_x_m)" />
    <arg name="lidar_y_m" value="$(arg lidar_y_m)" />
    <arg name="lidar_z_m" value="$(arg lidar_z_m)" />
    <arg name="lidar_yaw_deg" value="$(arg lidar_yaw_deg)" />

    <arg name="bypass_lateral_margin_m" value="0.85" />
    <arg name="bypass_longitudinal_margin_m" value="3.0" />
    <arg name="bypass_departure_length_m" value="14.0" />
    <arg name="bypass_return_length_m" value="14.0" />
    <arg name="bypass_extra_clearances_m" value="[0.0, 0.4, 0.8]" />
    <arg name="bypass_max_abs_d_m" value="3.8" />
    <arg name="bypass_min_transition_length_m" value="6.0" />
    <arg name="collision_longitudinal_margin_m" value="0.40" />
    <arg name="collision_lateral_margin_m" value="0.45" />
    <arg name="escape_prefix_m" value="3.0" />
  </include>

  <!-- BYPASS forwarding guard.  Camera lane boundaries are deliberately NOT
       used to veto obstacle BYPASS.  Strategic lane changes remain highway-only. -->
  <node pkg="purepursuit_mgeo"
        type="bypass_lane_guard_node.py"
        name="bypass_lane_guard"
        output="screen">
    <param name="path_file" value="$(arg path_file)" />
    <param name="map_frame" value="map" />
    <param name="base_selected_path_topic" value="/avoidance_frenet_debug/selected_path" />
    <param name="base_plan_status_topic" value="/avoidance_frenet_debug/plan_status" />
    <param name="lane_info_topic" value="$(arg lane_info_topic)" />
    <param name="odom_topic" value="/localization/odometry" />
    <param name="obstacle_topic" value="/perception/lidar/tracked_obstacles_map" />
    <param name="enable_obstacle_lane_change" value="false" />
    <param name="prefer_lane_change" value="false" />
    <param name="enforce_camera_lane_bounds_on_bypass" value="false" />
    <param name="allow_bypass_without_lane_info" value="true" />
    <param name="bypass_lane_boundary_margin_m" value="0.15" />
    <param name="fallback_bypass_max_abs_d_m" value="0.25" />

    <!-- Intersection detection is intentionally NOT required for BYPASS. -->

    <param name="vehicle_length_m" value="4.635" />
    <param name="vehicle_width_m" value="1.892" />
    <param name="vehicle_center_from_base_m" value="1.50" />
    <param name="collision_longitudinal_margin_m" value="0.40" />
    <param name="collision_lateral_margin_m" value="0.45" />
    <param name="wheelbase_m" value="3.0" />
    <param name="max_steering_rad" value="0.6981317008" />
    <param name="evaluation_speed_mps" value="$(arg target_speed_mps)" />
    <param name="max_lateral_accel_mps2" value="2.5" />
    <param name="escape_prefix_m" value="3.0" />
  </node>

  <!-- Normal obstacle PathManager. Strategic highway lane changes do NOT use
       this lane-change state; they are applied one level above it. -->
  <node pkg="purepursuit_mgeo"
        type="avoidance_path_manager_node.py"
        name="avoidance_path_manager"
        output="screen">
    <param name="path_file" value="$(arg path_file)" />
    <param name="map_frame" value="map" />
    <param name="odom_topic" value="/localization/odometry" />
    <param name="obstacle_topic" value="/perception/lidar/tracked_obstacles_map" />

    <param name="selected_path_topic" value="/bypass_lane_guard/selected_path" />
    <param name="planner_ready_topic" value="/bypass_lane_guard/planner_ready" />
    <param name="avoidance_required_topic" value="/bypass_lane_guard/avoidance_required" />
    <param name="safe_path_available_topic" value="/bypass_lane_guard/safe_path_available" />
    <param name="selected_kind_topic" value="/bypass_lane_guard/selected_kind" />
    <param name="selected_side_topic" value="/bypass_lane_guard/selected_side" />
    <param name="plan_status_topic" value="/bypass_lane_guard/plan_status" />
    <param name="use_atomic_plan_status" value="true" />
    <param name="allow_lane_change_control" value="false" />
    <param name="rate_hz" value="10.0" />
    <param name="normal_back_m" value="3.0" />
    <param name="normal_forward_m" value="80.0" />

    <param name="vehicle_length_m" value="4.635" />
    <param name="vehicle_width_m" value="1.892" />
    <param name="vehicle_center_from_base_m" value="1.50" />
    <param name="collision_longitudinal_margin_m" value="0.40" />
    <param name="collision_lateral_margin_m" value="0.45" />
    <param name="escape_prefix_m" value="3.0" />
    <param name="allow_same_side_guard_refresh" value="true" />
    <param name="guard_stop_confirm_s" value="0.30" />
    <param name="guard_refresh_min_interval_s" value="0.20" />
    <!-- Transient obstacle (e.g. pedestrian) cleared before the ego leaves the
         global route: discard the obsolete committed detour after a short
         confirmation instead of driving it anyway. -->
    <param name="cancel_cleared_bypass_near_global" value="true" />
    <param name="threat_clear_confirm_s" value="0.40" />
    <param name="threat_clear_max_abs_d_m" value="0.55" />
  </node>

  <!-- Highway strategy:
       highway detected -> wait for sensor-team LEFT merge gap -> commit local
       quintic lane change -> camera centerline lane-hold -> release only after
       the inner lane physically converges back to the global route. -->
  <node pkg="purepursuit_mgeo"
        type="highway_lane_strategy_node.py"
        name="highway_lane_strategy"
        output="screen">
    <param name="path_file" value="$(arg path_file)" />
    <param name="map_frame" value="map" />
    <param name="base_path_topic" value="/avoidance_path_manager/active_path" />
    <param name="base_stop_topic" value="/avoidance_path_manager/stop_required" />
    <param name="odom_topic" value="/localization/odometry" />
    <param name="obstacle_topic" value="/perception/lidar/tracked_obstacles_map" />
    <param name="lane_info_topic" value="$(arg lane_info_topic)" />
    <param name="highway_topic" value="$(arg highway_environment_topic)" />
    <param name="highway_request_topic" value="$(arg highway_request_topic)" />
    <param name="merge_available_topic" value="/perception/merge_gap/available" />
    <param name="merge_unavailable_topic" value="/perception/merge_gap/unavailable" />
    <param name="mission_request_bypass_sensor_merge_gate" value="true" />

    <param name="cruise_speed_mps" value="$(arg target_speed_mps)" />
    <param name="target_left_lane_changes" value="$(arg target_left_lane_changes)" />
    <param name="highway_confirm_s" value="0.5" />
    <param name="ready_confirm_s" value="0.5" />

    <param name="min_lane_confidence" value="0.45" />
    <param name="lane_width_min_m" value="2.7" />
    <param name="lane_width_max_m" value="4.2" />
    <param name="require_left_dashed" value="true" />

    <param name="change_start_m" value="2.0" />
    <param name="change_min_length_m" value="14.0" />
    <param name="change_max_length_m" value="18.0" />
    <param name="change_time_s" value="3.0" />
    <param name="max_lateral_accel_mps2" value="2.5" />

    <param name="front_min_gap_m" value="6.0" />
    <param name="rear_min_gap_m" value="7.0" />
    <param name="time_headway_s" value="1.5" />
    <param name="min_ttc_s" value="3.0" />
    <param name="gap_search_range_m" value="50.0" />

    <param name="follow_standstill_gap_m" value="4.0" />
    <param name="follow_time_headway_s" value="1.6" />
    <param name="follow_gain" value="0.35" />
    <param name="follow_search_m" value="60.0" />
    <param name="emergency_gap_m" value="1.5" />
    <param name="emergency_ttc_s" value="1.0" />

    <param name="vehicle_length_m" value="4.635" />
    <param name="vehicle_width_m" value="1.892" />
    <param name="vehicle_center_from_base_m" value="1.50" />
    <param name="collision_long_margin_m" value="0.50" />
    <param name="collision_lat_margin_m" value="0.35" />

    <param name="release_global_d_m" value="0.90" />
    <param name="release_confirm_s" value="1.0" />
    <param name="min_inner_hold_after_change_m" value="8.0" />
  </node>

  <!-- Roundabout gap logic remains separate from highway lane-change logic. -->
  <node if="$(arg enable_roundabout_merge_gate)"
        pkg="purepursuit_mgeo"
        type="roundabout_merge_gate_node.py"
        name="roundabout_merge_gate"
        output="screen">
    <param name="request_topic" value="$(arg merge_request_topic)" />
    <param name="odom_topic" value="/localization/odometry" />
    <param name="obstacle_topic" value="/perception/lidar/tracked_obstacles_map" />
    <param name="rate_hz" value="20.0" />
    <param name="conflict_x_m" value="7.0" />
    <param name="conflict_y_m" value="0.0" />
    <param name="conflict_radius_m" value="3.0" />
    <param name="search_x_min_m" value="-12.0" />
    <param name="search_x_max_m" value="25.0" />
    <param name="search_y_min_m" value="0.0" />
    <param name="search_y_max_m" value="22.0" />
    <param name="prediction_horizon_s" value="8.0" />
    <param name="required_arrival_gap_s" value="4.0" />
    <param name="clear_confirm_s" value="0.8" />
  </node>
</launch>
