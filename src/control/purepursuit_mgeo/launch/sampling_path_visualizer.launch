<launch>
    <!-- 현재 프로젝트의 MGeo path 파일로 수정 -->
    <arg name="path_file"
         default="$(find path_planning)/path/to/your/mgeo_path.txt"/>

    <arg name="map_frame" default="map"/>

    <arg name="local_length_m" default="30.0"/>
    <arg name="control_rate_hz" default="10.0"/>

    <!-- 오른쪽(-) ~ Global Path(0) ~ 왼쪽(+) -->
    <arg name="candidate_offsets_m"
         default="[-1.5, -0.75, 0.0, 0.75, 1.5]"/>

    <node pkg="path_planning"
          type="sampling_path_visualizer.py"
          name="sampling_path_visualizer"
          output="screen">

        <param name="path_file" value="$(arg path_file)"/>
        <param name="map_frame" value="$(arg map_frame)"/>
        <param name="local_length_m" value="$(arg local_length_m)"/>
        <param name="control_rate_hz" value="$(arg control_rate_hz)"/>
        <param name="candidate_offsets_m"
               value="$(arg candidate_offsets_m)"/>

    </node>
</launch>
