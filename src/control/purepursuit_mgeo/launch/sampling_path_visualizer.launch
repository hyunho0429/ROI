<launch>

    <arg name="workspace_path" default="/home/msclab/morai_ws"/>

    <!-- 현재 사용 중인 Global Path -->
    <arg name="path_file"
         default="$(arg workspace_path)/data/routes/2026_molit_comp_global_path.txt"/>

    <!--
      실제 link_set.json 위치에 맞게 이 한 줄만 수정하면 됩니다.
      예: $(arg workspace_path)/data/mgeo/link_set.json
    -->
    <arg name="link_set_file"
         default="$(arg workspace_path)/data/mgeo/link_set.json"/>

    <arg name="map_frame" default="map"/>

    <!-- Ego 앞에서 후보를 생성/표시할 총 길이 -->
    <arg name="local_length_m" default="45.0"/>

    <!-- 차선 변경 시작 위치 후보 -->
    <arg name="lane_change_start_distances_m"
         default="[3.0, 7.0, 11.0]"/>

    <!-- 차선 변경에 사용할 종방향 길이 후보 -->
    <arg name="lane_change_lengths_m"
         default="[15.0, 22.0]"/>

    <arg name="sample_spacing_m" default="0.5"/>
    <arg name="control_rate_hz" default="10.0"/>

    <node pkg="purepursuit_mgeo"
          type="sampling_path_visualizer.py"
          name="sampling_path_visualizer"
          output="screen">

        <param name="path_file" value="$(arg path_file)"/>
        <param name="link_set_file" value="$(arg link_set_file)"/>
        <param name="map_frame" value="$(arg map_frame)"/>

        <param name="local_length_m" value="$(arg local_length_m)"/>
        <param name="lane_change_start_distances_m"
               value="$(arg lane_change_start_distances_m)"/>
        <param name="lane_change_lengths_m"
               value="$(arg lane_change_lengths_m)"/>

        <param name="sample_spacing_m" value="$(arg sample_spacing_m)"/>
        <param name="control_rate_hz" value="$(arg control_rate_hz)"/>

        <!-- MGeo Link nearest 검색용 -->
        <param name="link_index_cell_size_m" value="10.0"/>
        <param name="link_index_point_stride" value="3"/>

    </node>

    <!-- RViz도 같이 실행 -->
    <node pkg="rviz"
          type="rviz"
          name="sampling_rviz"
          output="screen"/>
</launch>
