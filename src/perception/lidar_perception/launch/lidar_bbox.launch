<launch>
  <arg name="rviz" default="true" />
  <arg name="bind_ip" default="0.0.0.0" />
  <arg name="host_port" default="2000" />
  <arg name="destination_port" default="2001" />
  <arg name="odometry_topic" default="/localization/odometry" />
  <!-- Accepted for compatibility with the shared bringup; this pipeline does not publish it. -->
  <arg name="merge_status_topic" default="/perception/merge_gap/status" />
  <arg name="lidar_x_m" default="0.0" />
  <arg name="lidar_y_m" default="0.0" />
  <arg name="lidar_yaw_deg" default="0.0" />
  <include file="$(find lidar_perception)/launch/lidar_algorithm_pipeline.launch">
    <arg name="algorithm_type" value="lidar_bbox_node.py" />
    <arg name="algorithm_name" value="lidar_bbox" />
    <arg name="result_prefix" value="bbox" />
    <arg name="rviz_config" value="morai_lidar_bbox.rviz" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="bind_ip" value="$(arg bind_ip)" />
    <arg name="host_port" value="$(arg host_port)" />
    <arg name="destination_port" value="$(arg destination_port)" />
    <arg name="odometry_topic" value="$(arg odometry_topic)" />
    <arg name="lidar_x_m" value="$(arg lidar_x_m)" />
    <arg name="lidar_y_m" value="$(arg lidar_y_m)" />
    <arg name="lidar_yaw_deg" value="$(arg lidar_yaw_deg)" />
  </include>
</launch>
