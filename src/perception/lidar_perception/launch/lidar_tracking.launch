<launch>
  <arg name="rviz" default="true" />
  <arg name="bind_ip" default="0.0.0.0" />
  <arg name="host_port" default="2000" />
  <arg name="destination_port" default="2001" />
  <arg name="odometry_topic" default="/localization/odometry" />
  <arg name="map_obstacle_topic" default="/perception/lidar/tracked_obstacles_map" />
  <arg name="obstacle_state_enabled" default="true" />
  <arg name="obstacle_state_topic" default="/detection/obstacle_states" />
  <arg name="static_obstacle_topic" default="/detection/static_obstacles" />
  <arg name="dynamic_obstacle_topic" default="/detection/dynamic_obstacles" />
  <arg name="merge_available_topic" default="/perception/merge_gap/available" />
  <arg name="merge_unavailable_topic" default="/perception/merge_gap/unavailable" />
  <arg name="lidar_x_m" default="0.0" />
  <arg name="lidar_y_m" default="0.0" />
  <arg name="lidar_yaw_deg" default="0.0" />
  <arg name="min_hits" default="3" />
  <arg name="merge_gap_enabled" default="true" />
  <arg name="vehicle_length_m" default="4.635" />
  <arg name="vehicle_width_m" default="1.892" />
  <arg name="vehicle_height_m" default="2.434" />
  <arg name="lane_width_m" default="3.5" />
  <arg name="longitudinal_margin_m" default="1.0" />
  <arg name="time_headway_s" default="1.5" />
  <arg name="minimum_ttc_s" default="3.0" />
  <arg name="confirmation_scans" default="3" />
  <include file="$(find lidar_perception)/launch/lidar_algorithm_pipeline.launch">
    <arg name="algorithm_type" value="lidar_tracking_node.py" />
    <arg name="algorithm_name" value="lidar_tracking" />
    <arg name="result_prefix" value="tracking" />
    <arg name="rviz_config" value="morai_lidar_tracking.rviz" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="bind_ip" value="$(arg bind_ip)" />
    <arg name="host_port" value="$(arg host_port)" />
    <arg name="destination_port" value="$(arg destination_port)" />
    <arg name="odometry_topic" value="$(arg odometry_topic)" />
    <arg name="map_obstacle_topic" value="$(arg map_obstacle_topic)" />
    <!-- Tracking already performs Euclidean clustering, boxes, and Hungarian
         assignment. Disable only the duplicate clustering in the UDP node. -->
    <arg name="udp_cluster_enabled" value="false" />
    <arg name="lidar_x_m" value="$(arg lidar_x_m)" />
    <arg name="lidar_y_m" value="$(arg lidar_y_m)" />
    <arg name="lidar_yaw_deg" value="$(arg lidar_yaw_deg)" />
    <arg name="min_hits" value="$(arg min_hits)" />
  </include>

  <!-- State classification consumes the existing map tracker. It does not
       parse /morai/lidar/obstacles or run a second Kalman/Hungarian tracker. -->
  <node if="$(arg obstacle_state_enabled)"
        pkg="lidar_perception"
        type="lidar_tracked_obstacle_state_node.py"
        name="lidar_tracked_obstacle_state"
        output="screen">
    <param name="input_topic" value="$(arg map_obstacle_topic)" />
    <param name="output_topic" value="$(arg obstacle_state_topic)" />
    <param name="static_topic" value="$(arg static_obstacle_topic)" />
    <param name="dynamic_topic" value="$(arg dynamic_obstacle_topic)" />
  </node>

  <!-- Tracking is the minimum stage that can evaluate relative speed and TTC. -->
  <include if="$(arg merge_gap_enabled)"
           file="$(find lidar_perception)/launch/lidar_merge_gap_monitor.launch">
    <arg name="vehicle_length_m" value="$(arg vehicle_length_m)" />
    <arg name="vehicle_width_m" value="$(arg vehicle_width_m)" />
    <arg name="vehicle_height_m" value="$(arg vehicle_height_m)" />
    <arg name="lane_width_m" value="$(arg lane_width_m)" />
    <arg name="longitudinal_margin_m" value="$(arg longitudinal_margin_m)" />
    <arg name="time_headway_s" value="$(arg time_headway_s)" />
    <arg name="minimum_ttc_s" value="$(arg minimum_ttc_s)" />
    <arg name="confirmation_scans" value="$(arg confirmation_scans)" />
    <arg name="available_topic" value="$(arg merge_available_topic)" />
    <arg name="unavailable_topic" value="$(arg merge_unavailable_topic)" />
  </include>
</launch>
