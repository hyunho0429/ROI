<launch>
  <arg name="rviz" default="true" />
  <arg name="bind_ip" default="0.0.0.0" />
  <arg name="host_port" default="2000" />
  <arg name="destination_port" default="2001" />
  <arg name="odometry_topic" default="/localization/odometry" />
  <arg name="vehicle_length_m" default="4.635" />
  <arg name="vehicle_width_m" default="1.892" />
  <arg name="vehicle_height_m" default="2.434" />
  <arg name="lane_width_m" default="3.5" />
  <arg name="longitudinal_margin_m" default="1.0" />
  <arg name="time_headway_s" default="1.5" />
  <arg name="minimum_ttc_s" default="3.0" />
  <arg name="confirmation_scans" default="3" />

  <include file="$(find lidar_perception)/launch/lidar_tracking.launch">
    <arg name="rviz" value="false" />
    <arg name="bind_ip" value="$(arg bind_ip)" />
    <arg name="host_port" value="$(arg host_port)" />
    <arg name="destination_port" value="$(arg destination_port)" />
    <arg name="odometry_topic" value="$(arg odometry_topic)" />
    <arg name="min_hits" value="2" />
  </include>

  <node pkg="lidar_perception"
        type="lidar_merge_gap_node.py"
        name="lidar_merge_gap"
        output="screen">
    <param name="input_topic" value="/morai/lidar/tracking/results" />
    <param name="result_topic" value="/morai/lidar/merge_gap/results" />
    <param name="marker_topic" value="/morai/lidar/merge_gap/markers" />
    <param name="vehicle_length_m" value="$(arg vehicle_length_m)" />
    <param name="vehicle_width_m" value="$(arg vehicle_width_m)" />
    <param name="vehicle_height_m" value="$(arg vehicle_height_m)" />
    <param name="lane_width_m" value="$(arg lane_width_m)" />
    <param name="lane_lateral_allowance_m" value="0.4" />
    <param name="longitudinal_margin_m" value="$(arg longitudinal_margin_m)" />
    <param name="lateral_margin_m" value="0.2" />
    <param name="detection_range_m" value="40.0" />
    <param name="time_headway_s" value="$(arg time_headway_s)" />
    <param name="minimum_ttc_s" value="$(arg minimum_ttc_s)" />
    <param name="confirmation_scans" value="$(arg confirmation_scans)" />
    <param name="stale_timeout_s" value="0.5" />
  </node>

  <node if="$(arg rviz)"
        pkg="rviz"
        type="rviz"
        name="lidar_merge_gap_rviz"
        args="-d $(find lidar_perception)/rviz/morai_lidar_merge_gap.rviz"
        output="screen" />
</launch>
