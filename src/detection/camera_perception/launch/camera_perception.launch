<launch>
  <arg name="camera_stack_root" default="$(env HOME)/morai_ws/src/ROI" />
  <arg name="camera_ip" default="0.0.0.0" />
  <arg name="enable_lane" default="true" />
  <arg name="lane_port" default="1101" />
  <arg name="lane_checkpoint" default="$(find camera_perception)/lane/lane_seg_best.pt" />
  <arg name="lane_cam_set" default="$(find camera_perception)/lane/cam_set.json" />
  <arg name="lane_device" default="auto" />
  <arg name="lane_every" default="1" />
  <arg name="lane_scale" default="1.0" />
  <arg name="enable_yolo" default="true" />
  <arg name="yolo_port" default="1131" />
  <arg name="base_model_path" default="$(find camera_perception)/models/yolov8n.pt" />
  <arg name="custom_model_path" default="$(find camera_perception)/models/best0902.pt" />
  <arg name="yolo_confidence" default="0.4" />
  <arg name="yolo_inference_size" default="416" />
  <!-- 0: MORAI camera source rate; no extra GUI wait is inserted. -->
  <arg name="camera_display_fps" default="0.0" />
  <!-- 0: automatically reserve at least one VM CPU for UDP/decode/GUI. -->
  <arg name="yolo_cpu_threads" default="0" />
  <arg name="car_detected_topic" default="/perception/camera/car_detected" />
  <arg name="person_detected_topic" default="/perception/camera/person_detected" />
  <arg name="traffic_light_topic" default="/detection/traffic_light" />
  <arg name="camera_obstacle_topic" default="/detection/obstacle" />
  <arg name="dashed_lane_topic" default="/perception/camera/dashed_lane_detected" />
  <arg name="stopline_detected_topic" default="/perception/camera/stopline_detected" />
  <arg name="stopline_distance_topic" default="/perception/camera/stopline_distance_m" />
  <arg name="stopline_stop_topic" default="/perception/stopline/stop_required" />
  <arg name="stopline_clear_confirmation_s" default="0.5" />
  <arg name="highway_environment_topic" default="/perception/camera/highway_environment" />
  <arg name="enable_highway_gate" default="$(arg enable_yolo)" />
  <!-- 고속도로 환경 = YOLO car/bus/truck AND 왼쪽 점선. -->
  <arg name="require_dashed_lane" default="true" />
  <arg name="left_parallel_dynamic_topic" default="/perception/lidar/left_lane_parallel_dynamic_detected" />
  <arg name="require_left_parallel_dynamic" default="false" />
  <arg name="left_parallel_dynamic_hold_s" default="0.5" />
  <arg name="highway_latch_once" default="true" />
  <arg name="car_detection_hold_s" default="2.0" />
  <arg name="enable_pedestrian_crossing" default="$(arg enable_yolo)" />
  <arg name="pedestrian_stop_topic" default="/perception/pedestrian_crossing/stop_required" />
  <arg name="pedestrian_resume_topic" default="/perception/pedestrian_crossing/resume_allowed" />
  <arg name="pedestrian_status_topic" default="/perception/pedestrian_crossing/status" />
  <arg name="person_clear_confirmation_s" default="0.5" />
  <arg name="enable_intersection_detection" default="$(arg enable_yolo)" />
  <arg name="dynamic_obstacle_topic" default="/detection/dynamic_obstacles" />
  <arg name="odometry_topic" default="/localization/odometry" />
  <arg name="intersection_detected_topic" default="/perception/intersection/detected" />
  <arg name="intersection_driving_allowed_topic" default="/perception/intersection/driving_allowed" />
  <arg name="intersection_driving_unavailable_topic" default="/perception/intersection/driving_unavailable" />
  <arg name="intersection_status_topic" default="/perception/intersection/status" />
  <arg name="intersection_minimum_speed_mps" default="1.0" />
  <arg name="intersection_maximum_range_m" default="40.0" />
  <arg name="intersection_perpendicular_error_deg" default="20.0" />
  <arg name="intersection_camera_clear_confirmation_s" default="0.5" />

  <node if="$(arg enable_lane)"
        pkg="camera_perception"
        type="camera_feature_runner.py"
        name="lane_camera"
        output="screen"
        respawn="false"
        args="--mode lane --camera-stack-root $(arg camera_stack_root) --cam-ip $(arg camera_ip) --cam-port $(arg lane_port) --lane-checkpoint $(arg lane_checkpoint) --lane-cam-set $(arg lane_cam_set) --lane-device $(arg lane_device) --lane-every $(arg lane_every) --lane-scale $(arg lane_scale) --lane-ros-publish --dashed-lane-topic $(arg dashed_lane_topic) --stopline-detected-topic $(arg stopline_detected_topic) --stopline-distance-topic $(arg stopline_distance_topic) --stopline-stop-topic $(arg stopline_stop_topic) --stopline-clear-confirmation-s $(arg stopline_clear_confirmation_s)" />

  <node if="$(arg enable_yolo)"
        pkg="camera_perception"
        type="camera_feature_runner.py"
        name="yolo_camera"
        output="screen"
        respawn="false"
        args="--mode yolo --camera-stack-root $(arg camera_stack_root) --cam-ip $(arg camera_ip) --cam-port $(arg yolo_port) --base-model $(arg base_model_path) --custom-model $(arg custom_model_path) --confidence $(arg yolo_confidence) --inference-size $(arg yolo_inference_size) --display-fps $(arg camera_display_fps) --cpu-threads $(arg yolo_cpu_threads) --car-detected-topic $(arg car_detected_topic) --person-detected-topic $(arg person_detected_topic) --traffic-light-topic $(arg traffic_light_topic) --obstacle-topic $(arg camera_obstacle_topic)" />

  <node if="$(arg enable_highway_gate)"
        pkg="camera_perception"
        type="highway_environment_gate_node.py"
        name="highway_environment_gate"
        output="screen">
    <param name="car_detected_topic" value="$(arg car_detected_topic)" />
    <param name="dashed_lane_topic" value="$(arg dashed_lane_topic)" />
    <param name="output_topic" value="$(arg highway_environment_topic)" />
    <param name="require_dashed_lane" value="$(arg require_dashed_lane)" />
    <param name="left_parallel_dynamic_topic" value="$(arg left_parallel_dynamic_topic)" />
    <param name="require_left_parallel_dynamic" value="$(arg require_left_parallel_dynamic)" />
    <param name="left_parallel_dynamic_hold_s" value="$(arg left_parallel_dynamic_hold_s)" />
    <param name="latch_once" value="$(arg highway_latch_once)" />
    <param name="car_hold_s" value="$(arg car_detection_hold_s)" />
    <param name="dashed_lane_hold_s" value="2.0" />
    <param name="publish_rate_hz" value="10.0" />
  </node>

  <node if="$(arg enable_pedestrian_crossing)"
        pkg="camera_perception"
        type="pedestrian_crossing_fusion_node.py"
        name="pedestrian_crossing_fusion"
        output="screen">
    <param name="person_detected_topic" value="$(arg person_detected_topic)" />
    <param name="stop_topic" value="$(arg pedestrian_stop_topic)" />
    <param name="resume_topic" value="$(arg pedestrian_resume_topic)" />
    <param name="status_topic" value="$(arg pedestrian_status_topic)" />
    <param name="person_clear_confirmation_s" value="$(arg person_clear_confirmation_s)" />
    <param name="input_stale_timeout_s" value="0.5" />
    <param name="publish_rate_hz" value="20.0" />
  </node>

  <node if="$(arg enable_intersection_detection)"
        pkg="camera_perception"
        type="intersection_environment_node.py"
        name="intersection_environment"
        output="screen">
    <param name="car_topic" value="$(arg car_detected_topic)" />
    <param name="dynamic_obstacle_topic" value="$(arg dynamic_obstacle_topic)" />
    <param name="odometry_topic" value="$(arg odometry_topic)" />
    <param name="detected_topic" value="$(arg intersection_detected_topic)" />
    <param name="driving_allowed_topic" value="$(arg intersection_driving_allowed_topic)" />
    <param name="driving_unavailable_topic" value="$(arg intersection_driving_unavailable_topic)" />
    <param name="status_topic" value="$(arg intersection_status_topic)" />
    <param name="minimum_speed_mps" value="$(arg intersection_minimum_speed_mps)" />
    <param name="maximum_range_m" value="$(arg intersection_maximum_range_m)" />
    <param name="maximum_perpendicular_error_deg" value="$(arg intersection_perpendicular_error_deg)" />
    <param name="camera_clear_confirmation_s" value="$(arg intersection_camera_clear_confirmation_s)" />
    <param name="clear_hold_s" value="2.0" />
    <param name="input_stale_timeout_s" value="0.5" />
    <param name="publish_rate_hz" value="20.0" />
  </node>
</launch>
