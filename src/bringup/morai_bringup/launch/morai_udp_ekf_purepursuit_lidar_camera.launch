<launch>
  <!-- Existing driving + LiDAR tracking stack. Defaults intentionally match
       morai_udp_ekf_purepursuit_lidar_tracking.launch. -->
  <arg name="workspace_path" default="$(env HOME)/morai_ws" />
  <arg name="path_file" default="$(find morai_bringup)/../../../data/routes/2026_molit_comp_global_path.txt" />
  <arg name="bind_ip" default="0.0.0.0" />
  <arg name="competition_status_host_port" default="9080" />
  <arg name="competition_status_port" default="9081" />
  <arg name="morai_host_ip" default="192.168.0.151" />
  <arg name="control_remote_port" default="9093" />
  <arg name="target_speed_mps" default="2.0" />
  <arg name="lidar_x_m" default="0.0" />
  <arg name="lidar_y_m" default="0.0" />
  <arg name="lidar_yaw_deg" default="0.0" />
  <arg name="enable_control" default="false" />
  <arg name="rviz" default="true" />
  <arg name="merge_available_topic" default="/perception/merge_gap/available" />
  <arg name="merge_unavailable_topic" default="/perception/merge_gap/unavailable" />

  <!-- Camera defaults are preserved from feature-camera: lane=1101, YOLO=1131. -->
  <arg name="camera_stack_root" default="$(env HOME)/morai_ws/src/ROI" />
  <!-- Camera UDP receivers use the same local bind address as LiDAR. -->
  <arg name="camera_ip" default="$(arg bind_ip)" />
  <arg name="enable_lane" default="true" />
  <arg name="lane_port" default="1101" />
  <arg name="enable_yolo" default="true" />
  <arg name="yolo_port" default="1131" />
  <arg name="base_model_path" default="yolov8n.pt" />
  <arg name="custom_model_path" default="null.pt" />
  <arg name="yolo_confidence" default="0.4" />

  <include file="$(find morai_bringup)/launch/morai_udp_ekf_purepursuit_lidar_tracking.launch">
    <arg name="workspace_path" value="$(arg workspace_path)" />
    <arg name="path_file" value="$(arg path_file)" />
    <arg name="bind_ip" value="$(arg bind_ip)" />
    <arg name="competition_status_host_port" value="$(arg competition_status_host_port)" />
    <arg name="competition_status_port" value="$(arg competition_status_port)" />
    <arg name="morai_host_ip" value="$(arg morai_host_ip)" />
    <arg name="control_remote_port" value="$(arg control_remote_port)" />
    <arg name="target_speed_mps" value="$(arg target_speed_mps)" />
    <arg name="lidar_x_m" value="$(arg lidar_x_m)" />
    <arg name="lidar_y_m" value="$(arg lidar_y_m)" />
    <arg name="lidar_yaw_deg" value="$(arg lidar_yaw_deg)" />
    <arg name="enable_control" value="$(arg enable_control)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="merge_available_topic" value="$(arg merge_available_topic)" />
    <arg name="merge_unavailable_topic" value="$(arg merge_unavailable_topic)" />
  </include>

  <include file="$(find camera_perception)/launch/camera_perception.launch">
    <arg name="camera_stack_root" value="$(arg camera_stack_root)" />
    <arg name="camera_ip" value="$(arg camera_ip)" />
    <arg name="enable_lane" value="$(arg enable_lane)" />
    <arg name="lane_port" value="$(arg lane_port)" />
    <arg name="enable_yolo" value="$(arg enable_yolo)" />
    <arg name="yolo_port" value="$(arg yolo_port)" />
    <arg name="base_model_path" value="$(arg base_model_path)" />
    <arg name="custom_model_path" value="$(arg custom_model_path)" />
    <arg name="yolo_confidence" value="$(arg yolo_confidence)" />
  </include>
</launch>
