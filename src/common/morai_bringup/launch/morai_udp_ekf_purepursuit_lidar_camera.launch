<launch>
  <!-- Competition-ready integrated driving, LiDAR tracking and camera stack. -->
  <arg name="workspace_path" default="$(env HOME)/morai_ws" />
  <arg name="path_file" default="$(find morai_bringup)/../../../data/routes/2026_molit_comp_global_path.txt" />
  <arg name="bind_ip" default="0.0.0.0" />
  <arg name="competition_status_host_port" default="9080" />
  <arg name="competition_status_port" default="9081" />
  <arg name="morai_host_ip" default="192.168.0.148" />
  <arg name="control_remote_port" default="9093" />
  <arg name="target_speed_mps" default="6.0" />
  <arg name="lidar_x_m" default="0.0" />
  <arg name="lidar_y_m" default="0.0" />
  <arg name="lidar_yaw_deg" default="0.0" />
  <arg name="enable_control" default="true" />
  <arg name="rviz" default="true" />
  <arg name="merge_available_topic" default="/perception/merge_gap/available" />
  <arg name="merge_unavailable_topic" default="/perception/merge_gap/unavailable" />
  <arg name="merge_adjacent_obstacle_topic" default="/perception/merge_gap/left_lane_obstacles" />

  <!-- Camera defaults are preserved from feature-camera: lane=1101, YOLO=1131. -->
  <arg name="camera_stack_root" default="$(env HOME)/morai_ws/src/ROI" />
  <!-- Camera UDP receivers use the same local bind address as LiDAR. -->
  <arg name="camera_ip" default="$(arg bind_ip)" />
  <arg name="enable_lane" default="true" />
  <arg name="lane_port" default="1101" />
  <arg name="lane_checkpoint" default="$(find camera_perception)/lane/lane_seg_best.pt" />
  <arg name="lane_cam_set" default="$(find camera_perception)/lane/cam_set.json" />
  <arg name="lane_device" default="auto" />
  <arg name="lane_every" default="1" />
  <arg name="lane_scale" default="1.0" />
  <arg name="enable_yolo" default="true" />
  <arg name="yolo_port" default="1131" />
  <arg name="base_model_path" default="$(find camera_perception)/models/yolov8n.pt" />
  <arg name="custom_model_path" default="$(find camera_perception)/models/best0902.pt" />
  <arg name="yolo_confidence" default="0.4" />
  <arg name="yolo_inference_size" default="320" />
  <arg name="camera_display_fps" default="0.0" />
  <arg name="yolo_cpu_threads" default="1" />
  <arg name="car_detected_topic" default="/perception/camera/car_detected" />
  <arg name="person_detected_topic" default="/perception/camera/person_detected" />
  <arg name="traffic_light_topic" default="/detection/traffic_light" />
  <arg name="camera_obstacle_topic" default="/detection/obstacle" />
  <arg name="dashed_lane_topic" default="/perception/camera/dashed_lane_detected" />
  <arg name="stopline_detected_topic" default="/perception/camera/stopline_detected" />
  <arg name="stopline_distance_topic" default="/perception/camera/stopline_distance_m" />
  <arg name="stopline_stop_topic" default="/perception/stopline/stop_required" />
  <arg name="stopline_clear_confirmation_s" default="0.5" />
  <arg name="highway_environment_topic" default="/perception/camera/highway_environment" />
  <arg name="enable_highway_gate" default="$(arg enable_yolo)" />
  <arg name="merge_highway_gate_required" default="$(arg enable_highway_gate)" />
  <!-- 끼어들기 환경 = YOLO car/bus/truck AND 카메라 왼쪽 점선. -->
  <arg name="require_dashed_lane" default="true" />
  <arg name="left_parallel_dynamic_topic" default="/perception/lidar/left_lane_parallel_dynamic_detected" />
  <arg name="require_left_parallel_dynamic" default="false" />
  <arg name="left_parallel_dynamic_hold_s" default="0.5" />
  <arg name="highway_latch_once" default="true" />
  <arg name="car_detection_hold_s" default="2.0" />
  <arg name="enable_pedestrian_crossing" default="$(arg enable_yolo)" />
  <arg name="pedestrian_stop_topic" default="/perception/pedestrian_crossing/stop_required" />
  <arg name="pedestrian_resume_topic" default="/perception/pedestrian_crossing/resume_allowed" />
  <arg name="pedestrian_status_topic" default="/perception/pedestrian_crossing/status" />
  <arg name="person_clear_confirmation_s" default="0.5" />
  <arg name="enable_intersection_detection" default="$(arg enable_yolo)" />
  <arg name="intersection_detected_topic" default="/perception/intersection/detected" />
  <arg name="intersection_driving_allowed_topic" default="/perception/intersection/driving_allowed" />
  <arg name="intersection_driving_unavailable_topic" default="/perception/intersection/driving_unavailable" />
  <arg name="intersection_status_topic" default="/perception/intersection/status" />
  <arg name="intersection_minimum_speed_mps" default="1.0" />
  <arg name="intersection_maximum_range_m" default="40.0" />
  <arg name="intersection_perpendicular_error_deg" default="20.0" />
  <arg name="intersection_camera_clear_confirmation_s" default="0.5" />

  <include file="$(find morai_bringup)/launch/morai_udp_ekf_purepursuit_lidar_tracking.launch">
    <arg name="workspace_path" value="$(arg workspace_path)" />
    <arg name="path_file" value="$(arg path_file)" />
    <arg name="bind_ip" value="$(arg bind_ip)" />
    <arg name="competition_status_host_port" value="$(arg competition_status_host_port)" />
    <arg name="competition_status_port" value="$(arg competition_status_port)" />
    <arg name="morai_host_ip" value="$(arg morai_host_ip)" />
    <arg name="control_remote_port" value="$(arg control_remote_port)" />
    <arg name="target_speed_mps" value="$(arg target_speed_mps)" />
    <arg name="lidar_x_m" value="$(arg lidar_x_m)" />
    <arg name="lidar_y_m" value="$(arg lidar_y_m)" />
    <arg name="lidar_yaw_deg" value="$(arg lidar_yaw_deg)" />
    <arg name="enable_control" value="$(arg enable_control)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="merge_available_topic" value="$(arg merge_available_topic)" />
    <arg name="merge_unavailable_topic" value="$(arg merge_unavailable_topic)" />
    <arg name="merge_adjacent_obstacle_topic" value="$(arg merge_adjacent_obstacle_topic)" />
    <arg name="merge_highway_gate_required" value="$(arg merge_highway_gate_required)" />
    <arg name="highway_gate_topic" value="$(arg highway_environment_topic)" />
    <arg name="pedestrian_stop_topic" value="$(arg pedestrian_stop_topic)" />
    <arg name="stopline_stop_topic" value="$(arg stopline_stop_topic)" />
  </include>

  <include file="$(find camera_perception)/launch/camera_perception.launch">
    <arg name="camera_stack_root" value="$(arg camera_stack_root)" />
    <arg name="camera_ip" value="$(arg camera_ip)" />
    <arg name="enable_lane" value="$(arg enable_lane)" />
    <arg name="lane_port" value="$(arg lane_port)" />
    <arg name="lane_checkpoint" value="$(arg lane_checkpoint)" />
    <arg name="lane_cam_set" value="$(arg lane_cam_set)" />
    <arg name="lane_device" value="$(arg lane_device)" />
    <arg name="lane_every" value="$(arg lane_every)" />
    <arg name="lane_scale" value="$(arg lane_scale)" />
    <arg name="enable_yolo" value="$(arg enable_yolo)" />
    <arg name="yolo_port" value="$(arg yolo_port)" />
    <arg name="base_model_path" value="$(arg base_model_path)" />
    <arg name="custom_model_path" value="$(arg custom_model_path)" />
    <arg name="yolo_confidence" value="$(arg yolo_confidence)" />
    <arg name="yolo_inference_size" value="$(arg yolo_inference_size)" />
    <arg name="camera_display_fps" value="$(arg camera_display_fps)" />
    <arg name="yolo_cpu_threads" value="$(arg yolo_cpu_threads)" />
    <arg name="car_detected_topic" value="$(arg car_detected_topic)" />
    <arg name="person_detected_topic" value="$(arg person_detected_topic)" />
    <arg name="traffic_light_topic" value="$(arg traffic_light_topic)" />
    <arg name="camera_obstacle_topic" value="$(arg camera_obstacle_topic)" />
    <arg name="dashed_lane_topic" value="$(arg dashed_lane_topic)" />
    <arg name="stopline_detected_topic" value="$(arg stopline_detected_topic)" />
    <arg name="stopline_distance_topic" value="$(arg stopline_distance_topic)" />
    <arg name="stopline_stop_topic" value="$(arg stopline_stop_topic)" />
    <arg name="stopline_clear_confirmation_s" value="$(arg stopline_clear_confirmation_s)" />
    <arg name="highway_environment_topic" value="$(arg highway_environment_topic)" />
    <arg name="enable_highway_gate" value="$(arg enable_highway_gate)" />
    <arg name="require_dashed_lane" value="$(arg require_dashed_lane)" />
    <arg name="left_parallel_dynamic_topic" value="$(arg left_parallel_dynamic_topic)" />
    <arg name="require_left_parallel_dynamic" value="$(arg require_left_parallel_dynamic)" />
    <arg name="left_parallel_dynamic_hold_s" value="$(arg left_parallel_dynamic_hold_s)" />
    <arg name="highway_latch_once" value="$(arg highway_latch_once)" />
    <arg name="car_detection_hold_s" value="$(arg car_detection_hold_s)" />
    <arg name="enable_pedestrian_crossing" value="$(arg enable_pedestrian_crossing)" />
    <arg name="pedestrian_stop_topic" value="$(arg pedestrian_stop_topic)" />
    <arg name="pedestrian_resume_topic" value="$(arg pedestrian_resume_topic)" />
    <arg name="pedestrian_status_topic" value="$(arg pedestrian_status_topic)" />
    <arg name="person_clear_confirmation_s" value="$(arg person_clear_confirmation_s)" />
    <arg name="enable_intersection_detection" value="$(arg enable_intersection_detection)" />
    <arg name="dynamic_obstacle_topic" value="/detection/dynamic_obstacles" />
    <arg name="odometry_topic" value="/localization/odometry" />
    <arg name="intersection_detected_topic" value="$(arg intersection_detected_topic)" />
    <arg name="intersection_driving_allowed_topic" value="$(arg intersection_driving_allowed_topic)" />
    <arg name="intersection_driving_unavailable_topic" value="$(arg intersection_driving_unavailable_topic)" />
    <arg name="intersection_status_topic" value="$(arg intersection_status_topic)" />
    <arg name="intersection_minimum_speed_mps" value="$(arg intersection_minimum_speed_mps)" />
    <arg name="intersection_maximum_range_m" value="$(arg intersection_maximum_range_m)" />
    <arg name="intersection_perpendicular_error_deg" value="$(arg intersection_perpendicular_error_deg)" />
    <arg name="intersection_camera_clear_confirmation_s" value="$(arg intersection_camera_clear_confirmation_s)" />
  </include>
</launch>
