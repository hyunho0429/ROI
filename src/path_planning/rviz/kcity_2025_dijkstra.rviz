Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 20
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 80
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /mgeo_links_marker
      Name: MGeo Link Lines
      Namespaces:
        kcity_links: true
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /mgeo_nodes_marker
      Name: MGeo Node Markers
      Namespaces:
        kcity_nodes: true
      Queue Size: 100
      Value: true
    - Alpha: 1
      Class: rviz/PointCloud
      Color: 120; 120; 255
      Color Transformer: FlatColor
      Enabled: true
      Name: MGeo Nodes
      Position Transformer: XYZ
      Queue Size: 10
      Size (Pixels): 5
      Size (m): 0.20000000298023224
      Style: Points
      Topic: /node
      Unreliable: false
      Value: true
    - Alpha: 0.65
      Class: rviz/PointCloud
      Color: 230; 230; 230
      Color Transformer: FlatColor
      Enabled: true
      Name: MGeo Links
      Position Transformer: XYZ
      Queue Size: 10
      Size (Pixels): 2
      Size (m): 0.10000000149011612
      Style: Points
      Topic: /link
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 25; 255; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.07999999821186066
      Name: Dijkstra Global Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Queue Size: 10
      Topic: /global_path
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Scale: 1600
      Target Frame: map
      X: -160
      Y: -100
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
