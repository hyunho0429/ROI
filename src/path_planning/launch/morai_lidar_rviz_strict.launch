<launch>
  <!-- Strict version: remove every return that is not vertically supported
       by a different LiDAR ring at nearly the same horizontal location. -->
  <arg name="rviz" default="true" />
  <arg name="bind_ip" default="0.0.0.0" />
  <arg name="host_port" default="2000" />
  <arg name="destination_port" default="2001" />
  <arg name="deskew_enabled" default="true" />
  <arg name="deskew_pose_source" default="sensor_udp" />
  <arg name="gps_port" default="3001" />
  <arg name="imu_port" default="4001" />
  <arg name="vertical_support_radius_m" default="0.65" />
  <arg name="vertical_support_min_height_m" default="0.05" />

  <include file="$(find path_planning)/launch/morai_lidar_rviz.launch">
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="lidar_node_type" value="morai_lidar_pointcloud_udp_ground_strict.py" />
    <arg name="bind_ip" value="$(arg bind_ip)" />
    <arg name="host_port" value="$(arg host_port)" />
    <arg name="destination_port" value="$(arg destination_port)" />
    <arg name="deskew_enabled" value="$(arg deskew_enabled)" />
    <arg name="deskew_pose_source" value="$(arg deskew_pose_source)" />
    <arg name="gps_port" value="$(arg gps_port)" />
    <arg name="imu_port" value="$(arg imu_port)" />
    <arg name="ring_filter_mode" value="strict" />
    <arg name="vertical_support_radius_m" value="$(arg vertical_support_radius_m)" />
    <arg name="vertical_support_min_height_m" value="$(arg vertical_support_min_height_m)" />
    <arg name="fast_nearest_enabled" value="true" />
    <arg name="cluster_min_points" value="3" />
  </include>
</launch>
